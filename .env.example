# ----- Network Settings -----
SERVER_IP=YOUR_SERVER_IP
# Fallback / Stealth domain for XTLS Reality
# Must be a real TLS 1.3 + HTTP/2 site. Keep dest and SNI consistent.
REALITY_DEST=www.apple.com:443
REALITY_SERVER_NAME=www.apple.com
# Client TLS fingerprint used in generated VLESS links.
REALITY_FINGERPRINT=edge
# Comma-separated fingerprints printed for every client.
# If one gets filtered, import the same profile with another fingerprint.
REALITY_FINGERPRINTS=edge,firefox,safari,chrome,android,ios
# Base spiderX path. Client links append the username to keep paths distinct.
REALITY_SPIDER_X=/

# ----- Ports -----
XRAY_PORT=443
XRAY_PORT_ALT=8443
XRAY_PORT_XHTTP=9443
# XHTTP is the recommended first profile under current filtering.
# generate-secrets.sh replaces this placeholder with a per-deployment path.
XHTTP_PATH=/__CHANGE_ME_XHTTP_PATH__
XHTTP_MODE=auto
# Update manually by changing this tag, then run:
# docker compose pull xray && bash scripts/render-config.sh && docker compose up -d xray
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.6.1

# ----- XRAY Secrets -----
# XRAY_PUBLIC_KEY stores the Xray x25519 client-side "Password" value.
# Changing these values invalidates existing client import links.
XRAY_PRIVATE_KEY=
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=

# ----- ANTI-TORRENT FIREWALL -----
# Controls whether to apply the DOCKER-USER iptables firewall rules
ENABLE_FIREWALL=true

# Firewall Mode: 'balanced' or 'strict'
# 'balanced': Blocks typical P2P/Torrent ports (6881-6999). Allows everything else.
# 'strict'  : Whitelist behavior. Only allows Web (TCP 80/443) and DNS. Blocks everything else, including QUIC (UDP 443).
FIREWALL_MODE=balanced

# ----- DOMAIN BLOCKLIST (Anti-Piracy) -----
# Optional domain-based blocking using Xray routing
ENABLE_DOMAIN_BLOCKLIST=true
DOMAIN_BLOCKLIST_PROVIDER=local
